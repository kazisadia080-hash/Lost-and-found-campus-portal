# ===== Backend (put these in server/.env) =====
# MongoDB Atlas connection string from Atlas > Connect > Drivers.
# Replace <username>, <password>, cluster host, and add your db name before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lostfound?retryWrites=true&w=majority

# Any long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_string

# Frontend origin (for CORS). Local dev: http://localhost:5173
# In production: your Vercel URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Backend port (optional, defaults to 5000)
PORT=5000

# Admin registration code — required for admin signup. Set to any secret string.
ADMIN_REGISTRATION_CODE=change_this_to_your_secret_code

# Email/SMTP config for account deletion OTP.
# For Gmail, use host=smtp.gmail.com port=587 and your Gmail address + App Password.
# If left blank, emails are logged to the server console instead of being sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Lost & Found <noreply@lostfound.local>

# ===== Frontend (put these in client/.env) =====
# Backend API base URL. Local dev: http://localhost:5000
# In production: your Render URL, e.g. https://your-app.onrender.com
VITE_API_URL=http://localhost:5000
